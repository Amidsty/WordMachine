# Copy to .env, edit, then: set -a; . ./.env; set +a
WM_ENV=development
WM_HOST=127.0.0.1
WM_PORT=5000
WM_DEBUG=false
WM_LOG_LEVEL=INFO
WM_SECRET_KEY='replace-with-a-random-secret'
WM_DB_HOST=127.0.0.1
WM_DB_PORT=3306
WM_DB_USER=wm
WM_DB_PASSWORD='replace-with-your-database-password'
WM_DB_NAME=wm
# Session lifetime and fixed-window auth limits (counts include failed attempts).
WM_SESSION_SECONDS=604800
WM_AUTH_LIMIT_WINDOW=300
WM_LOGIN_IP_LIMIT=30
WM_LOGIN_ACCOUNT_LIMIT=10
WM_REGISTER_IP_LIMIT=10
# Manual Rating password rechecks: per actor; IP bucket uses WM_LOGIN_IP_LIMIT.
WM_RATING_ADJUST_LIMIT=10
# Use a random, stable WM_SECRET_KEY; generate with:
# python -c 'import secrets; print(secrets.token_hex(32))'
# Socket.IO allows same-origin requests only. Production cookies require HTTPS.
# X-Forwarded-For is not trusted automatically; configure trusted proxies before deployment.
