# Example only. Copy to .env and supply your own dedicated database credentials.
# The application does not automatically load .env.
WM_ENV=development
WM_DEBUG=false
WM_HOST=127.0.0.1
WM_PORT=5000
WM_LOG_LEVEL=INFO

# Generate a long, random, stable secret. Never commit a real secret.
WM_SECRET_KEY=replace-with-a-long-random-stable-secret
WM_DB_HOST=127.0.0.1
WM_DB_PORT=3306
WM_DB_USER=wm
WM_DB_PASSWORD=
WM_DB_NAME=wm

WM_SESSION_SECONDS=604800
WM_AUTH_LIMIT_WINDOW=300
WM_LOGIN_IP_LIMIT=30
WM_LOGIN_ACCOUNT_LIMIT=10
WM_REGISTER_IP_LIMIT=10
WM_RATING_ADJUST_LIMIT=10
